<%# PROPOSALS -- none of these is in the app. The bar markup is copied from layouts/_casa_banner so the
    only difference between rows is the lead. Each row appears full width AND at 390px, because "does
    the bold lead cost height?" has a different answer once the text wraps.

    Preview scaffolding uses inline styles on purpose: Tailwind scans app/, not spec/, so a utility
    used only in this file would not exist in the built CSS and the preview would lie. %>
<% bar = "flex items-start gap-3 border-b border-l-4 border-amber-200 border-l-amber-600 bg-amber-50 px-4 py-3 text-sm text-amber-900 sm:px-6" %>
<% icon = tag.i("", class: "bi bi-megaphone mt-0.5 shrink-0 text-base leading-5", aria: {hidden: true}) %>
<% dismiss = tag.button("Dismiss", type: "button", class: "shrink-0 rounded font-medium text-amber-700 underline underline-offset-2") %>
<% body = "Quarterly court reports are due at month end. Please log any outstanding case contacts before then." %>
<% name = banner.name %>
<% label = "margin:0 0 8px;font:600 11px/1.4 ui-monospace,monospace;letter-spacing:.04em;color:#475569" %>
<% note = "margin:8px 0 0;font:13px/1.5 system-ui;color:#64748b" %>
<% bold = "font-semibold" %>

<% rows = [
     ["A &mdash; CONTENT ONLY (SHIPPED)", nil,
      "What the app renders today."],
     ["B &mdash; BOLD NAME + PERIOD", tag.span("#{name}.", class: bold),
      "Reads as two sentences when the name is a noun phrase rather than a sentence."],
     ["C &mdash; BOLD NAME + COLON", tag.span("#{name}:", class: bold),
      "Marks the name as a label instead of a sentence. My pick."],
     ["D &mdash; BOLD NAME + EM DASH", safe_join([tag.span(name, class: bold), " —"]),
      "Also standard, slightly more decorative."],
     ["E &mdash; BOLD NAME, NO PUNCTUATION", tag.span(name, class: bold),
      "Bootstrap's convention. Reads best when the lead is a fragment like &ldquo;Heads up&rdquo;."],
     ["F &mdash; THE RISK: AN ADMIN-SHORTHAND NAME", tag.span("sept banner test 2.", class: bold),
      "`name` is the admin's label for the row today, not user-facing copy. Old banners may read like this."]
   ] %>

<div style="display:flex;flex-direction:column;gap:40px">
  <% rows.each do |row_label, lead, row_note| %>
    <div>
      <p style="<%= label %>"><%= sanitize(row_label) %></p>
      <div class="<%= bar %>">
        <%= icon %>
        <div class="min-w-0 flex-1"><% if lead %><%= lead %> <% end %><%= body %></div>
        <%= dismiss %>
      </div>
      <div style="width:390px;margin-top:12px;border:1px solid #cbd5e1;border-radius:6px;overflow:hidden">
        <div class="<%= bar %>">
          <%= icon %>
          <div class="min-w-0 flex-1"><% if lead %><%= lead %> <% end %><%= body %></div>
          <%= dismiss %>
        </div>
      </div>
      <p style="<%= note %>"><%= sanitize(row_note) %></p>
    </div>
  <% end %>

  <div>
    <p style="<%= label %>">G &mdash; TITLE ON ITS OWN LINE (POLARIS / MATERIAL STYLE)</p>
    <div class="<%= bar %>">
      <%= icon %>
      <div class="min-w-0 flex-1">
        <p class="font-semibold"><%= name %></p>
        <p><%= body %></p>
      </div>
      <%= dismiss %>
    </div>
    <div style="width:390px;margin-top:12px;border:1px solid #cbd5e1;border-radius:6px;overflow:hidden">
      <div class="<%= bar %>">
        <%= icon %>
        <div class="min-w-0 flex-1">
          <p class="font-semibold"><%= name %></p>
          <p><%= body %></p>
        </div>
        <%= dismiss %>
      </div>
    </div>
    <p style="<%= note %>">Survives rich content of any shape, but always costs a line for the title.</p>
  </div>

  <div>
    <p style="<%= label %>">H &mdash; THE CATCH: RICH TEXT WITH TWO PARAGRAPHS, FORCED INLINE</p>
    <div class="<%= bar %>">
      <%= icon %>
      <div class="min-w-0 flex-1">
        <span class="font-semibold"><%= name %>.</span>
        <span class="trix-content">
          <div style="display:inline"><%= body %></div>
          <div style="display:inline">A second paragraph, as Trix would produce it.</div>
        </span>
      </div>
      <%= dismiss %>
    </div>
    <div style="width:390px;margin-top:12px;border:1px solid #cbd5e1;border-radius:6px;overflow:hidden">
      <div class="<%= bar %>">
        <%= icon %>
        <div class="min-w-0 flex-1">
          <span class="font-semibold"><%= name %>.</span>
          <span class="trix-content">
            <div style="display:inline"><%= body %></div>
            <div style="display:inline">A second paragraph, as Trix would produce it.</div>
          </span>
        </div>
        <%= dismiss %>
      </div>
    </div>
    <p style="<%= note %>">
      `content` is an ActionText rich-text field, so it is block HTML. Forcing it inline does fit on one
      line &mdash; but read it: the author's paragraph break vanishes and the two paragraphs run
      together as one sentence. A bulleted list would collapse the same way. That is the real cost of
      the inline form, not height.
    </p>
  </div>
</div>
