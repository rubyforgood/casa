<% if @resource.is_a?(User) %>
  <p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">A <%= @resource.casa_org.display_name %> <%= @resource.type %> console account has been created for you. This console is for logging the time you spend and actions you take on your CASA case &mdash; with your CASA youth, their family, their foster family or placement, the DSS worker, your case supervisor, and others (such as teachers and therapists).</p>
  <p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">Your account is tied to this email address. If it isn&rsquo;t the right one, stop here and contact your case supervisor to change it. Otherwise, set your password to get started.</p>
<% else %>
  <p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">A CASA console admin account has been created for you, tied to this email address. When you&rsquo;re ready, set your password to get started.</p>
<% end %>
<%= render "mailer_shared/cta_button", url: accept_invitation_url(@resource, invitation_token: @token), label: "Set your password" %>
<p style="margin:16px 0 0; font-size:15px; line-height:1.6; color:#334155;">This invitation will expire on <%= I18n.l(@resource.invitation_due_at, format: :full, default: nil) %><% if @resource.is_a?(AllCasaAdmin) %> (one week).<% elsif @resource.is_a?(Supervisor) || @resource.is_a?(CasaAdmin) %> (two weeks).<% elsif @resource.is_a?(Volunteer) %> (one year).<% end %></p>
