<p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">Hello <%= @user.display_name %>,</p>
<% reimbursement_amount = @case_contact.reimbursement_amount %>
<p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">Your reimbursement request for <%= @case_contact.miles_driven %>mi<% if reimbursement_amount %> (<%= number_to_currency(reimbursement_amount) %>)<% end %> on <%= @case_contact.occurred_at_display %> has been processed and is en route.</p>
<p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">You can view your case contacts and their reimbursement status by visiting <a href="<%= case_contacts_url(casa_case_id: @case_contact.casa_case_id) %>" style="color:#4f46e5; text-decoration:underline;">this link</a>.</p>
<p style="margin:0; font-size:15px; line-height:1.6; color:#334155;">If you have any questions, please contact your most recent CASA supervisor for assistance.</p>
