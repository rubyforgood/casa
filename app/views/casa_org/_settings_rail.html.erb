<%# Shared settings sub-nav rail. `panels: true` on casa_org/edit -- section items switch in-page
    panels via the settings-nav Stimulus controller (the controller drives the active highlight).
    `panels: false` on the standalone admin pages -- section items navigate to the settings page and
    open that section via the URL hash, and `active` statically highlights the current item. %>
<% panels = local_assigns.fetch(:panels, false) %>
<% active = local_assigns.fetch(:active, nil) %>
<% base = "flex items-center gap-2.5 rounded-lg px-3 py-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand-500" %>
<% idle = "text-slate-600 hover:bg-slate-100" %>
<% on = "bg-brand-50 font-semibold text-brand-700" %>
<% group_label = "px-3 pb-1 text-xs font-semibold text-slate-400" %>
<% sections = [
     ["Organization", [["Details", "bi-building", "organization-details"], ["Languages", "bi-translate", "languages"], ["Custom links", "bi-link-45deg", "custom-org-links"]]],
     ["Case setup", [["Contact types", "bi-tags", "contact-types"], ["Contact topics", "bi-chat-square-dots", "case-contact-topics"], ["Placement types", "bi-house-door", "placement-types"]]],
     ["Court", [["Hearing types", "bi-bank", "hearing-types"], ["Judges", "bi-person-badge", "judges"], ["Sent emails", "bi-envelope", "sent-emails"]]],
     ["Volunteer setup", [["Learning hours", "bi-mortarboard", "learning-hours"]]]
   ] %>
<% admin_items = [["Manage admins", "bi-person-badge", casa_admins_path, "manage-admins"], ["Mileage rates", "bi-cash-coin", mileage_rates_path, "mileage-rates"], ["Banners", "bi-megaphone", banners_path, "banners"], ["Imports", "bi-upload", imports_path, "imports"]] %>
<nav class="hidden shrink-0 space-y-5 text-sm lg:sticky lg:top-6 lg:block lg:w-48" aria-label="Settings sections">
  <% sections.each do |group, items| %>
    <div>
      <p class="<%= group_label %>"><%= group %></p>
      <% items.each do |label, icon, key| %>
        <% if panels %>
          <%= link_to "##{key}", data: {settings_nav_target: "link", key: key, action: "settings-nav#navigate"}, class: "#{base} #{idle}" do %><i class="bi <%= icon %>" aria-hidden="true"></i> <%= label %><% end %>
        <% else %>
          <%= link_to edit_casa_org_path(current_organization, anchor: key), class: "#{base} #{active == key ? on : idle}" do %><i class="bi <%= icon %>" aria-hidden="true"></i> <%= label %><% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <div>
    <p class="<%= group_label %>">Administration</p>
    <% admin_items.each do |label, icon, path, key| %>
      <%= link_to path, class: "#{base} #{active == key ? on : idle}" do %><i class="bi <%= icon %>" aria-hidden="true"></i> <%= label %><% end %>
    <% end %>
  </div>
</nav>
