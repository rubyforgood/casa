<% content_for :page_title, "Emancipation checklist" %>
<%# emancipations#show on casa_app. AJAX save and collapse live in
    controllers/emancipation_checklist_controller.js. Every hook below carries behavior.

    Keep the .emancipation-category h6 with data-is-open. Keep its child .category-collapse-icon.
    Keep the IMMEDIATELY-adjacent .category-options sibling. The controller reads that sibling
    with nextElementSibling.

    The .emacipation-category-input-label-pair is a div, not a label. A real label would
    double-toggle the checkbox the JS already flips.

    Keep each .check-item with its O#{id} / C#{category} inputs. Inputs are pointer-events-none.
    Labels have no for=. The controller sets checked after the save succeeds. A native toggle
    on click would invert add/delete vs the DOM. The save path value feeds the fetch calls. %>
<% check_class = "h-4 w-4 shrink-0 rounded border-slate-300 text-brand-600 focus:ring-brand-500" %>
<% radio_class = "h-4 w-4 shrink-0 border-slate-300 text-brand-600 focus:ring-brand-500" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl space-y-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Emancipation checklist</h1>
        <%= link_to @current_case.case_number, casa_case_path(@current_case), class: "mt-1 inline-block text-sm font-medium text-brand-600 hover:text-brand-700" %>
      </div>
      <%= link_to casa_case_emancipation_path(@current_case, format: :docx), class: button_classes(:primary) do %>
        <i class="bi bi-download" aria-hidden="true"></i> Download checklist
      <% end %>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
         data-controller="emancipation-checklist"
         data-emancipation-checklist-save-path-value="<%= save_casa_case_emancipation_path(@current_case) %>">
      <%# Inline save status replaces the jQuery Notifier: confirmations in the status target,
          errors in the error target. Roles status/alert announce the change to screen readers.
          Both targets sit inside the controller element: Stimulus only binds targets in scope. %>
      <p class="min-h-5 text-sm font-medium text-slate-500" role="status" data-emancipation-checklist-target="status"></p>
      <p class="min-h-5 text-sm font-medium text-rose-600" role="alert" data-emancipation-checklist-target="error"></p>
      <% @emancipation_form_data.each do |category| %>
        <h2 class="emancipation-category no-select flex items-center justify-between gap-3 border-b border-slate-100 py-2.5 last:border-b-0" data-is-open="<%= emancipation_category_checkbox_checked(@current_case, category) ? "true" : "false" %>">
          <div class="emacipation-category-input-label-pair flex cursor-pointer items-center gap-2.5" data-action="click->emancipation-checklist#toggleCategory">
            <%= tag.input(type: "checkbox", class: "emancipation-category-check-box pointer-events-none #{check_class}", value: category.id, checked: emancipation_category_checkbox_checked(@current_case, category), aria: {label: category.name}) %>
            <div class="text-sm font-medium text-slate-800"><%= category.name %></div>
          </div>
          <% if category.emancipation_options.count > 0 %>
            <span class="category-collapse-icon grid h-6 w-6 shrink-0 cursor-pointer select-none place-items-center rounded text-lg leading-none text-slate-500 hover:bg-slate-100"
                  data-action="click->emancipation-checklist#toggleChildren"><%= emancipation_category_collapse_icon(@current_case, category) %></span>
          <% end %>
        </h2>
        <div class="category-options ml-[9px] space-y-1 border-l border-slate-200 py-1 pl-5" style="<%= emancipation_category_collapse_hidden(@current_case, category) %>">
          <% category.emancipation_options.each do |option| %>
            <div class="check-item flex cursor-pointer items-center gap-2.5 py-1 text-sm text-slate-700" data-action="click->emancipation-checklist#toggleOption">
              <% if category.mutually_exclusive %>
                <%= tag.input(type: "radio", id: "O#{option.id}", class: "emancipation-radio-button pointer-events-none #{radio_class}", name: "C#{category.id}", value: option.id, checked: emancipation_option_checkbox_checked(@current_case, option), aria: {label: option.name}) %>
              <% else %>
                <%= tag.input(type: "checkbox", id: "O#{option.id}", class: "emancipation-option-check-box pointer-events-none #{check_class}", value: option.id, checked: emancipation_option_checkbox_checked(@current_case, option), aria: {label: option.name}) %>
              <% end %>
              <label><%= option.name %></label>
            </div>
          <% end %>
          <%# The labels intentionally have no for= matching the inputs. Inputs keep aria-label
              for an accessible name. %>
        </div>
      <% end %>
    </div>
  </div>
</div>
