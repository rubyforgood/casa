<% content_for :page_title, "Draft case contacts" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Draft case contacts</h1>
  </div>

  <%# Volunteers get their own drafts (rows with Continue/Discard); admins and supervisors get
      the org-wide card list. Same route, both paginated. %>
  <% if @case_contacts.any? %>
    <div class="space-y-4">
      <% if current_user.volunteer? %>
        <%= render partial: "case_contacts/draft_row", collection: @case_contacts, as: :contact %>
      <% else %>
        <%= render partial: "case_contacts/case_contact", collection: @case_contacts, as: :contact, locals: {heading_level: 2} %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center text-sm text-slate-500 shadow-sm">
      <%= current_user.volunteer? ? "No unfinished case contacts." : "No draft case contacts." %>
    </div>
  <% end %>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
