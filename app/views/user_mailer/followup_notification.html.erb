<p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">Hello <%= @user.display_name %>,</p>
<p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;"><%= @followup.creator&.display_name %> flagged a case contact for <%= @case_contact.casa_case.case_number %> that needs follow-up.</p>
<% if @followup.note.present? %>
  <p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">Note: <%= @followup.note %></p>
<% end %>
<p style="margin:0; font-size:15px; line-height:1.6; color:#334155;">You can review it by visiting <a href="<%= edit_case_contact_url(@case_contact) %>" style="color:#4f46e5; text-decoration:underline;">this link</a>.</p>
