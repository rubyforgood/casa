<%# One primary-nav link (design.md "Left nav"). Locals: title, icon (a bi-* class), path, key
    (matched against @active_nav for the active state), external (opens in a new tab). Used by the
    grouped nav in casa_app. %>
<% active = (@active_nav == key) %>
<% external = local_assigns[:external] %>
<%= link_to path, "aria-current": (active ? "page" : nil), target: (external ? "_blank" : nil), rel: (external ? "noopener" : nil), class: "flex items-center gap-3 rounded-lg px-3 py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand-500 #{active ? "bg-brand-50 font-semibold text-brand-700" : "text-slate-600 hover:bg-slate-100"}" do %>
  <i class="bi <%= icon %> shrink-0 text-base" aria-hidden="true"></i>
  <span class="min-w-0 truncate"><%= title %></span>
  <% if external %>
    <span class="sr-only">(opens in a new tab)</span>
    <i class="bi bi-box-arrow-up-right ml-auto shrink-0 text-xs text-slate-500" aria-hidden="true"></i>
  <% end %>
<% end %>
