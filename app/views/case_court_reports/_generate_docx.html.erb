<%# Court report generator (index). A Dialog (design-system) + the court-report Stimulus
    controller (reused from the case-show modal) that posts the case + date range to the JSON
    generate endpoint, shows a spinner, then opens the docx download. The case picker is a
    searchable single-select TomSelect (searchable-select) — its text search covers the volunteer
    names embedded in the option labels. Spec-locked ids kept: #generate-docx-report-modal,
    #case-selection, #btnGenerateReport, #start_date, #end_date, #spinner, #user-time-zone. %>
<% input_class = "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
<% label_class = "mb-1.5 block text-sm font-medium text-slate-700" %>
<%= render Dialog::GroupComponent.new(id: "generate-docx-report-modal", label: "Generate court report", controllers: "court-report") do |dialog| %>
  <% dialog.with_trigger do %>
    <%= tag.button type: "button", data: {action: "modal#open"}, class: button_classes(:primary) do %>
      <i class="bi bi-file-earmark-word" aria-hidden="true"></i> Generate report
    <% end %>
  <% end %>
  <%= form_with url: generate_case_court_reports_path, local: false, data: {court_report_target: "form"} do |form| %>
    <%= render Dialog::HeaderComponent.new(title: "Generate court report") %>
    <%= render Dialog::BodyComponent.new(classes: "space-y-4") do %>
      <p class="text-sm text-slate-600">To download a court report, choose an active case and specify the date range.</p>
      <div data-court-report-target="error" class="hidden rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700" role="alert"></div>
      <div>
        <label for="case-selection" class="<%= label_class %>">Case</label>
        <% select_options = @assigned_cases.map { |casa_case| casa_case.decorate.court_report_select_option } %>
        <%# A supervisor or admin sees EVERY active case in the chapter here (hundreds), so this has to
            search, not scroll -- and it must LOOK like it does. It always searched, but with only a
            `prompt:` option and no `placeholder-value` the controller left allowEmptyOption true, so
            TomSelect took "Select case number" as a selected *item*: an item at rest means
            `.input-hidden` (the search input parked at `left: -10000px`), no placeholder and no
            magnifier, so the field was indistinguishable from a plain dropdown and nothing invited
            you to type. With a placeholder the blank option is neither an item nor a menu row, the
            input stays on screen with its magnifier and hint, and the prompt stops posing as a value.
            See design.md "Searchable single-select".
            Minimal class only: the tom-select theme owns the border/padding/shadow on .ts-control, and
            TomSelect copies these classes onto .ts-wrapper -- a bordered input_class here double-borders.
            One case (the common volunteer shape) is preselected, so nothing is left for them to fill. %>
        <% only_case = (@assigned_cases.size == 1) ? @assigned_cases.first.case_number : nil %>
        <%= select_tag :case_number, options_for_select(select_options, only_case), prompt: "Select case number", include_blank: false, id: "case-selection",
              data: {controller: "searchable-select", "searchable-select-placeholder-value": "Search case number",
                     court_report_target: "caseSelect", action: "change->court-report#caseChanged"}, class: "block w-full" %>
      </div>
      <%= form.hidden_field :time_zone, id: "user-time-zone", data: {court_report_target: "timeZone"} %>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :start_date, "Starting from", class: label_class %>
          <%# BOTH dates are empty until a case is chosen, then the controller fills them together:
              "Starting from" = that case's last hearing, else the day it was opened (carried per option
              as data-start-date, since the default is per-case and the case is chosen here); "Ending
              at" = today. An end date pre-filled with today beside an empty start date is the
              asymmetry that read as broken. Neither is `required`: submitted blank, the generator
              applies the same last-hearing default and an open-ended finish server-side, and native
              validation here would pre-empt the "choose a case" error. %>
          <%= form.date_field :start_date, id: "start_date", value: nil,
                data: {court_report_target: "startDate"}, class: input_class %>
        </div>
        <div>
          <%= form.label :end_date, "Ending at", class: label_class %>
          <%= form.date_field :end_date, id: "end_date", value: nil,
                data: {court_report_target: "endDate"}, class: input_class %>
        </div>
      </div>
      <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
        <%= form.check_box :include_empty_topics, class: "h-4 w-4 shrink-0 rounded border-slate-300 text-brand-600 focus:ring-brand-500" %>
        <span>Include sections with no entries</span>
      </label>
    <% end %>
    <%= render Dialog::FooterComponent.new do %>
      <button type="button" data-action="modal#close" class="<%= button_classes(:secondary) %>">Cancel</button>
      <button type="submit" id="btnGenerateReport" data-action="court-report#generate" data-court-report-target="submit" class="<%= button_classes(:primary) %>">
        <i id="spinner" class="bi bi-arrow-repeat hidden animate-spin" data-court-report-target="spinner" aria-hidden="true"></i>
        <i class="bi bi-download" aria-hidden="true"></i> Generate report
      </button>
    <% end %>
  <% end %>
<% end %>
