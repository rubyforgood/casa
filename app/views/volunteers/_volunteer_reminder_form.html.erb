<%# Send-a-reminder Dialog (casa_app). "Send reminder" opens a design-system Dialog to optionally
    CC the supervisor/admin (role-aware label via the decorator), then PATCHes volunteers#reminder
    and redirects back. Mirrors casa_cases/_volunteer_reminder_form. The modal UI is covered by a
    :js system spec; the CC-by-role logic by the volunteers#reminder request spec (the checkbox +
    submit live inside the native <dialog>, so non-JS specs cannot reach them). %>
<%= render Dialog::GroupComponent.new(label: "Send a reminder to #{formatted_name(volunteer.display_name)}", wrapper_class: "contents") do |dialog| %>
  <% dialog.with_trigger do %>
    <%= button_tag type: "button", data: {action: "modal#open"}, title: "Remind volunteer to input case contacts", class: button_classes(:secondary) do %>
      <i class="bi bi-bell" aria-hidden="true"></i> Send reminder
    <% end %>
  <% end %>
  <%= form_with url: reminder_volunteer_path(volunteer), method: :patch do %>
    <%= render Dialog::HeaderComponent.new(title: "Send a reminder?", icon: "bi bi-bell", variant: :info) %>
    <%= render Dialog::BodyComponent.new do %>
      <p class="text-sm text-slate-600">Email <%= formatted_name(volunteer.display_name) %> a reminder to log their case contacts.</p>
      <label class="mt-3 flex items-center gap-2 text-sm text-slate-700">
        <%= check_box_tag "with_cc", 1, false, class: "h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" %>
        <%= volunteer.decorate.cc_reminder_text %>
      </label>
    <% end %>
    <%= render Dialog::FooterComponent.new do %>
      <button type="button" data-action="modal#close" class="<%= button_classes(:secondary) %>">Cancel</button>
      <%= button_tag "Yes, send reminder", type: "submit", class: button_classes(:primary) %>
    <% end %>
  <% end %>
<% end %>
